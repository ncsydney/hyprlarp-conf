{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch_small" //,
    // "color": {
    //   "1": "#89b4fa",
    //   "2": "#74c7ec"
    // }
  },

  "display": {
    "separator": "  ➜  "//,
    // "color": {
    //   "keys": "#cba6f7",
    //   "title": "#89b4fa"
    // }
  },

  "modules": [
    // {
    //   "type": "title",
    //   "key":"User    ",
    //   "format": "{user-name}@{host-name}",
      // "color": {
      //   "user": "#cba6f7",
      //   "host": "#89b4fa"
      // }
    // },

    "break",

    {
      "type": "os",
      "key": "󰣇 OS        "
    },
    // {
    //   "key": "{icon} Distro    ",
    //   "type": "os"
    // },

    {
      "type": "kernel",
      "key": "│ 󰒋 Kernel  "
    },
    
    {
      "type": "packages",
      "key": "│ 󰏖 Packages"
    },

    {
      "type": "shell",
      "key": "│  Shell   "
    },

    {
      "type": "terminal",
      "key": "│ 󰆍 Terminal"
    },
    
    {
      "type": "wm",
      "key": "└  WM      "
    },

    "break",

    {
      "type": "host",
      "key": "󰟀 Host:     "
    },

    {
      "type": "cpu",
      "key": "│ 󰻠 Cpu     "
    },

    {
      "type": "gpu",
      "key": "│ 󰍛 Gpu     "
    },

    {
      "type": "memory",
      "key": "│ 󰑭 Ram     "
    },

    {
      "type": "disk",
      "key": "└  Disk    "
  },

    "break",
    
    {
      "type": "uptime",
      "key": "󰅐 Uptime    "
    },

    {
      "type": "datetime",
      "key": "│  Date:   ",
      "format": "{hour-pretty}:{minute-pretty}, {weekday} {month-name-short} {day-in-month} {year}"
    },

    {
      "type": "command",
      "key": "└  OS Birth",
      "text": "birth_install=$(stat -c %W /); echo $(date -d @$birth_install '+%H:%M, %A %b %d %Y')"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}