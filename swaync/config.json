{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-width": 400,
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-window-width": 380,
  "notification-body-image-height": 220,
  "notification-body-image-width": 220,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟 Clear All"
    },
    "mpris": {
    },
    "volume": {
      "label": "󰕾",
      "step": 5
    },
    "backlight": {
      "label": "󰃠",
      "device": "nvidia_wmi_ec_backlight",
      "step": 5
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰝟",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "type": "toggle"
        },
        {
          "label": "",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "type": "toggle"
        },
        {
          "label": "󰤨",
          "command": "rofi-wifi-menu",
          "tooltip": "Netwerk"
        },
        {
          "label": "󰂯",
          "command": "rofi-bluetooth",
          "tooltip": "Bluetooth"
        },
        {
          "label": "󰂛",
          "command": "swaync-client -d",
          "type": "toggle",
          "tooltip": "DnD"
        },
        {
          "label": "",
          "command": "hyprlock",
          "tooltip": "Lock"
        },
        {
          "label": "󰜉",
          "command": "reboot",
          "tooltip": "Reboot"
        },
        {
          "label": "⏻",
          "command": "shutdown now",
          "tooltip": "shutdown"
        }
      ]
    }
  }
}